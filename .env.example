# LLM Provider (Groq Console: https://console.groq.com)
GROQ_API_KEY=your_groq_key_here

# Web Search API (Tavily: https://tavily.com)
TAVILY_API_KEY=your_tavily_key_here

# Real-time Flights API (Aviationstack: https://aviationstack.com)
AVIATIONSTACK_API_KEY=your_aviationstack_key_here

# Default Origin Airport (IATA Code, e.g. DAC=Dhaka, DEL=Delhi, JFK=New York)
DEFAULT_ORIGIN=DAC

# PostgreSQL on Render (Internal URL for Render deployment, External URL for local/pgAdmin)
# Note: Do NOT put quotes around the DATABASE_URL
DATABASE_URL=postgresql://username:password@dpg-xxxx.render.com/tripmate_db?sslmode=require

# LangSmith Tracing & Observability (https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_key_here
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=tripmate-ai
LANGCHAIN_PROJECT=tripmate-ai
